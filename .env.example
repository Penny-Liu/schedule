# Browser-safe Supabase configuration only. Never place a service-role or secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key

# Required for the username-based Auth migration and login.
# Use a real domain you control; do not use .invalid, .test, localhost, or example.com.
VITE_AUTH_USERNAME_DOMAIN=auth.your-controlled-domain.com

# Server-side sync credentials belong in the local/server environment and must not use VITE_ prefixes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
