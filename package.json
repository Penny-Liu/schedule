{
  "name": "schedule",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node pages/sync-scheduler.js & vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:migrate": "node scripts/migrate-users-to-supabase-auth.mjs",
    "pdf:verify": "node scripts/verify-pdf-font.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run build",
    "build": "vite build",
    "preview": "vite preview",
    "sync-assistant-sheet": "node scripts/sync-assistant-to-student-sheet.mjs",
    "sf:list-objects": "node scripts/salesforce-list-objects.mjs",
    "sf:describe": "node scripts/salesforce-describe-object.mjs",
    "cap:sync": "vite build --base=./ && cap sync",
    "cap:open": "cap open ios",
    "predeploy": "vite build --base=/schedule/",
    "deploy": "gh-pages -d dist",
    "sync-stats": "node scripts/sync-all-to-supabase.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.1",
    "@capacitor/ios": "^8.0.1",
    "@capgo/capacitor-native-biometric": "^8.2.0",
    "@fontsource/noto-sans-tc": "^5.2.8",
    "@supabase/supabase-js": "^2.111.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "dotenv": "^17.3.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
